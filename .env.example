# Billar optional overrides.
# Config loads `.env` from the current working directory only (cwd-only `.env`).
# Existing non-empty environment variables win over values in this file.
# `billar setup` creates runtime directories but does not write `.env`.

# Optional override: log level.
LOG_LEVEL=info

# Optional override: SQLite database path. Leave unset to use a per-user default:
# $XDG_DATA_HOME/billar/billar.db, then os.UserConfigDir()/billar/billar.db,
# then ~/.local/share/billar/billar.db.
# BILLAR_DB_PATH=/absolute/path/to/billar.db

# Optional override: CLI PDF/file export root. When unset, defaults to
# <db-parent>/exports, where <db-parent> is the directory containing BILLAR_DB_PATH.
# BILLAR_EXPORT_DIR=/absolute/path/to/exports

# Optional override: local backup directory. When unset, defaults to
# <db-parent>/backups, where <db-parent> is the directory containing BILLAR_DB_PATH.
# BILLAR_BACKUP_DIR=/absolute/path/to/backups
